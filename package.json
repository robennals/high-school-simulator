{
  "name": "high-school-simulator",
  "private": true,
  "type": "module",
  "scripts": {
    "sim": "node --import tsx src/headless/run.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "strategies": "node --import tsx src/headless/strategies.ts",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "realism": "node --import tsx src/headless/realism.ts",
    "cards": "node --import tsx src/headless/cards-sim.ts",
    "talk": "node --import tsx src/headless/cards-talk.ts",
    "threads": "node --import tsx src/headless/cards-threads.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "playwright": "^1.65.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "three": "^0.187.0"
  }
}
